{
  "config_version": "1.0.0-locked-for-local-run",
  "frozen_p2": {
    "corpus": "data/adaptasi_indonesia/corpus_whatsapp_10000.csv",
    "sha256": "a014a02ebad298a33267da8631f3a2d1906a537ae558c1849622904c225467e6",
    "immutable": true
  },
  "chunking": {
    "min_messages_per_chunk": 30,
    "max_messages_per_chunk": 60,
    "group_by": "merged participant chat",
    "time_window_minutes": 120
  },
  "embedding": {
    "final_method": "ollama",
    "final_model": "bge-m3",
    "ci_fallback": "hashing",
    "rationale": "BGE-M3 is multilingual and available locally through Ollama."
  },
  "vector_store": {
    "type": "local_json",
    "namespace": "case_evidence",
    "input_contract": "P4 ART artifacts only; never source reconstruction or evaluator ground truth"
  },
  "retrieval": {
    "top_k": 8,
    "similarity_metric": "cosine",
    "full_chunk_text_to_llm": true
  },
  "ollama": {
    "host": "http://localhost:11434",
    "model": "llama3.1:8b",
    "temperature": 0.1,
    "seed": 42,
    "num_ctx": 8192,
    "request_timeout_seconds": 180
  },
  "prompt": {
    "prompt_version": "v2-forensic-grounded",
    "requires_art_citations": true,
    "abstain_when_evidence_missing": true
  },
  "experiment": {
    "conditions": [
      "A_llm_only",
      "B_llm_rag",
      "C_llm_rag_structured"
    ],
    "questions": "configs/investigation_tasks.json",
    "lock_outputs_before_ground_truth": true
  },
  "prohibited_inputs": [
    "court narrative",
    "Document 547",
    "source reconstruction",
    "skema_ground_truth_privat",
    "expected_entity_ids",
    "expected_relation_ids",
    "is_key_evidence"
  ]
}
