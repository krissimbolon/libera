    "host": "http://localhost:11434",
    "model": "qwen2.5:1.5b",
    "temperature": 0.1,
    "seed": 42,
    "num_ctx": 8192,
    "request_timeout_seconds": 600,
    "num_predict": 2048,
    "repeat_penalty": 1.2,
    "repeat_last_n": 256,
    "transport_retries": 2
  },
  "prompt": {
    "prompt_version": "v6-forensic-grounded-repeat-control",
    "requires_art_citations": true,
    "abstain_when_evidence_missing": true,
